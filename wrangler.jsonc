{
  // Static site served by the "first" Worker (remtadigital.com). No build step.
  // src/worker.js runs first on every request (www -> apex redirect, the /api counter and contact form) and hands the
  // rest to the assets; unknown paths get public/404.html with status 404.
  "name": "first",
  "compatibility_date": "2026-05-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // Cookie-free counter for CV downloads and email clicks: one SQLite-backed Durable Object,
  // created on deploy (available on the Workers Free plan). Stores only day, event and count.
  "durable_objects": {
    "bindings": [{ "name": "COUNTER", "class_name": "Counter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }],
  // Contact form: src/worker.js sends each message through Cloudflare Email Routing. The recipient is
  // the CONTACT_TO secret (a verified destination address), so no address is kept in this repository.
  "send_email": [{ "name": "MAILER" }]
}
